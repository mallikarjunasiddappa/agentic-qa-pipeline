# Local dev (docker-compose.yml) - matches its POSTGRES_USER/PASSWORD/DB exactly.
# Pointing this at any hosted Postgres later (Azure Database for PostgreSQL, DigitalOcean Managed
# Databases, etc.) is a value change here only - nothing in prisma/schema.prisma or generated
# client code depends on where the database actually runs. See ../docs/planning's Phase 2 ADR.
DATABASE_URL="postgresql://qa_pipeline:local_dev_only@localhost:5432/qa_pipeline_backend"

# Optional. Only needed for the AI Queue's resolve route's fileJiraBug:true option (see
# src/lib/jiraClient.mjs and README.md's "AI Queue" section) - filing a real Jira bug from an
# approved defect QueueItem. Flat, single-tenant env vars (not the CLI pipeline's per-tenant
# envFileTenantKey()/secretsProvider.ts resolution - backend/ is still single-tenant-per-deployment
# as of Phase 2). Leave unset to run without this capability; the route returns a clear 503 instead
# of the server failing to start.
# JIRA_BASE_URL="https://your-domain.atlassian.net"
# JIRA_EMAIL="bot@your-domain.com"
# JIRA_API_TOKEN="..."
# JIRA_PROJECT_KEY="SCRUM"
