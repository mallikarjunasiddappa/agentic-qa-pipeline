{
  "name": "qa_pipeline_cli",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/setup-merge-drivers.mjs",
    "setup:git": "node scripts/setup-merge-drivers.mjs",
    "pipeline": "tsx src/pipeline/orchestrator/pipeline.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:critical": "playwright test --grep @critical",
    "test:regression": "playwright test --grep @regression",
    "test:regression:allure": "playwright test --grep @regression --reporter=line,allure-playwright",
    "report:allure": "allure generate allure-results --output allure-report && allure open allure-report",
    "verify:azure-key-vault": "tsx scripts/verify-azure-key-vault.ts",
    "verify:testiny-tms": "tsx scripts/verify-testiny-tms.ts",
    "backfill:manifest": "tsx scripts/backfillManifest.ts",
    "backfill:test-titles": "tsx scripts/backfillTestTitles.ts",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "drift:check": "tsx src/pipeline/orchestrator/pipeline.ts --stage drift-check",
    "healing:report": "tsx src/pipeline/orchestrator/pipeline.ts --stage healing-report",
    "flaky:report": "tsx src/pipeline/orchestrator/pipeline.ts --stage flaky-report",
    "suite-health:report": "tsx src/pipeline/orchestrator/pipeline.ts --stage suite-health",
    "prompt-versions:report": "tsx src/pipeline/orchestrator/pipeline.ts --stage prompt-version-report",
    "assertion-check": "tsx src/pipeline/orchestrator/pipeline.ts --stage assertion-check",
    "locator-check": "tsx src/pipeline/orchestrator/pipeline.ts --stage locator-check",
    "traceability-coverage-check": "tsx src/pipeline/orchestrator/pipeline.ts --stage traceability-coverage-check",
    "manifest-provenance-check": "tsx src/pipeline/orchestrator/pipeline.ts --stage manifest-provenance-check",
    "spec-file-consolidation-check": "tsx src/pipeline/orchestrator/pipeline.ts --stage spec-file-consolidation-check",
    "secrets-check": "tsx src/pipeline/orchestrator/pipeline.ts --stage secrets-check",
    "forbidden-playwright-patterns-check": "tsx src/pipeline/orchestrator/pipeline.ts --stage forbidden-playwright-patterns-check",
    "required-tags-check": "tsx src/pipeline/orchestrator/pipeline.ts --stage required-tags-check",
    "verify-guardrails-locally": "tsx src/pipeline/orchestrator/pipeline.ts --stage verify-guardrails-locally",
    "cost:record": "tsx src/pipeline/orchestrator/pipeline.ts --stage cost-record",
    "cost:report": "tsx src/pipeline/orchestrator/pipeline.ts --stage cost-report",
    "pipeline:report": "tsx src/pipeline/orchestrator/pipeline.ts --stage pipeline-report",
    "dev:status": "tsx src/pipeline/orchestrator/pipeline.ts --stage dev-status",
    "sprint:status": "tsx src/pipeline/orchestrator/pipeline.ts --stage sprint-status",
    "standup:digest": "tsx src/pipeline/orchestrator/pipeline.ts --stage standup-digest",
    "blocker:scan": "tsx src/pipeline/orchestrator/pipeline.ts --stage blocker-scan",
    "approve:scenarios": "tsx src/pipeline/orchestrator/pipeline.ts --stage approve-scenarios",
    "approve:test-cases": "tsx src/pipeline/orchestrator/pipeline.ts --stage approve-test-cases",
    "flag:requirement-gaps": "tsx src/pipeline/orchestrator/pipeline.ts --stage flag-requirement-gaps",
    "traceability:link": "tsx src/pipeline/orchestrator/pipeline.ts --stage traceability-link",
    "traceability:accept-baseline": "tsx src/pipeline/orchestrator/pipeline.ts --stage traceability-accept-baseline",
    "traceability:unlink": "tsx src/pipeline/orchestrator/pipeline.ts --stage traceability-unlink",
    "traceability:rename": "tsx src/pipeline/orchestrator/pipeline.ts --stage rename-spec-file",
    "approve:requirements": "tsx src/pipeline/orchestrator/pipeline.ts --stage approve-requirements"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "allure": "^3.14.3",
    "allure-playwright": "^3.10.2",
    "prettier": "^3.9.6",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@anthropic-ai/sdk": "^0.120.0",
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "nodemailer": "^9.0.5",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  }
}
