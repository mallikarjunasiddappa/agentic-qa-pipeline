# Copy this file to .env and fill in real values. Never commit .env itself.

# Jira Agent (Jira Cloud REST API v3)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# Test Management (TMS) Agent
# TMS_PROVIDER selects the adapter. "qase" or "testiny" are supported today - defaults to "qase" if omitted.
TMS_PROVIDER=qase
# Qase REST API
QASE_API_TOKEN=your-qase-api-token
# Project's short code, found in Qase at app.qase.io/project/<CODE> or Project Settings.
# Not the same as JIRA_PROJECT_KEY above - these are two separate systems' project identifiers.
QASE_PROJECT_CODE=your-qase-project-code
# Testiny REST API (only used if TMS_PROVIDER=testiny). Create a key at
# https://app.testiny.io/settings/api-keys - treat it like a password.
TESTINY_API_KEY=your-testiny-api-key
# Numeric project id, found in the Testiny UI's project settings (not a project code/slug).
TESTINY_PROJECT_ID=your-testiny-project-id

# VCS Client (Scrum Master Automation Program's dev-status stage, Phase 1). Which VCS provider is
# used is set per-tenant in config/tenants/<tenantId>/scrum.json's vcs.provider, not here - only
# "github" has a real adapter today. Create a fine-grained PAT at
# https://github.com/settings/personal-access-tokens with read-only Pull requests + Contents
# access on the repo below.
GITHUB_TOKEN=your-github-pat
# owner/repo, e.g. your-org/agentic-qa-pipeline
GITHUB_REPO=owner/repo
# Optional. How many traceability/manifest.json entries drift-check fetches from the TMS
# concurrently, instead of one at a time. Defaults to 5 (a conservative starting point, not a
# documented Qase rate limit) if unset. Raise it if drift-check is slow and your TMS plan can take
# it; lower it if you start seeing 429s.
DRIFT_CHECK_CONCURRENCY=

# Team usage (see README's Team Usage section). Optional - who's running this CLI on this
# machine, recorded on workflow gate records (requirementsClearedBy/scenariosApprovedBy/
# testCasesApprovedBy in traceability/manifest.json) so a team can see who cleared/approved what.
# Falls back to JIRA_EMAIL below if unset - only set this explicitly if it should read as
# something else (e.g. Jenkins using "ci-bot").
PIPELINE_OPERATOR=

# Pipeline health report (npm run pipeline:report). Optional - if unset, the report is still
# written to pipelineReport/report.json and report.html, the Slack notification is just skipped.
# Create one at https://api.slack.com/messaging/webhooks (Slack app > Incoming Webhooks).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
# Slack posts from pipeline:report/drift:check are CI-only by default - with more than one person
# on this pipeline, everyone running these locally to sanity-check before pushing would otherwise
# spam the shared channel every time. Set to "true" here to opt back in locally (e.g. to test the
# Slack integration itself). Has no effect in CI - GitHub Actions sets CI=true, which already
# allows it regardless of this value.
SLACK_NOTIFY_LOCAL=
# Traceability drift check (npm run drift:check). Optional, separate webhook/channel from
# SLACK_WEBHOOK_URL above on purpose - drift alerts and the general health heartbeat go to
# different audiences. Create a second incoming webhook pointed at whichever channel you want
# drift alerts in.
DRIFT_CHECK_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/other-webhook/url
# Cost & Latency report (npm run cost:report / --stage cost-report [--issue PROJ-123]). Optional,
# own webhook/channel, same reasoning as DRIFT_CHECK_SLACK_WEBHOOK_URL above - cost visibility is
# its own audience. If unset, the report is still written to cost/report.json/.md (or
# cost/report-<key>.json/.md for a --issue-scoped run), the Slack post is just skipped. Same
# CI-only-by-default gating as every other Slack integration here (SLACK_NOTIFY_LOCAL above).
COST_REPORT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/cost-report-webhook/url
# blocker-scan's related-recipient "slack-channel" delivery (Phase 2) - own webhook/channel, same
# reasoning as the two above. Optional - if unset, blocker-scan still writes its report and still
# posts the Jira comment/Slack DM side of escalation, it just skips this one channel.
BLOCKER_SCAN_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/blocker-scan-webhook/url
# Simple merge-ping (.github/workflows/merge-notify.yml) - posts "PR #X merged: <title>" once per
# merged PR. CI-only (a GitHub Actions secret, not something you set locally) - added here only so
# the full set of Slack env vars is documented in one place. Own webhook/channel, same reasoning
# as DRIFT_CHECK_SLACK_WEBHOOK_URL above - a merge-ping fires far more often than the daily health
# report and would otherwise drown it out. Optional - if unset in the repo's Actions secrets, the
# workflow step just skips.
MERGE_NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/merge-notify-webhook/url
# Full ticket summary (npm run pipeline -- --stage ticket-summary --issue PROJ-123). A Bot User
# OAuth Token (starts "xoxb-"), not a webhook - this DMs *you specifically*, which a webhook can't
# do. Requires a Slack App with the users:read.email and chat:write bot scopes, created once by a
# workspace admin and shared with the team - see the onboarding doc (docs/slack-ticket-summary-
# setup.docx) for step-by-step setup. Optional - if unset, the stage still prints the summary to
# your terminal, it just skips the DM.
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Which email --stage ticket-summary looks you up by in Slack. Optional - falls back to JIRA_EMAIL
# above. Only set this if your Slack account uses a different email than your Jira identity.
SLACK_USER_EMAIL=
# Optional. Public URL report.html is reachable at (e.g. GitHub Pages) - if set, the Slack message
# links directly to it instead of just naming the local file path, and report.html's "Full X
# report" sub-links point at that same site's self-hosted cost/report.html etc. instead of a
# relative path that only resolves in a local repo checkout. Sourced in CI from a repo Actions
# variable (see README's Pipeline Health Report section); leave unset for local runs.
PIPELINE_REPORT_PUBLIC_URL=

# Anthropic Console API key (console.anthropic.com - a separate product/billing account from
# claude.ai Pro/Max subscriptions). Optional - if unset, --stage flag-requirement-gaps-headless,
# --stage ask, and --stage draft-story are simply unavailable; every other stage is unaffected.
# Was previously undocumented here despite the first two stages already depending on it - added
# now alongside draft-story (a third dependent) rather than leaving the gap in place.
ANTHROPIC_API_KEY=your-anthropic-console-api-key

# AI Queue backend (backend/, Phase 2/A/B/C - "AI-Assisted Scrum and SDLC Console - Development
# Plan," docs/planning/). Optional - only --stage draft-story needs these; every other stage is
# unaffected. Point BACKEND_API_URL at a running `npm run dev` instance (backend/README.md) and
# BACKEND_PROJECT_ID at a real Project.id from that backend's database (e.g. the id
# scripts/migrate-tenant.mjs printed when it created one for this tenant).
BACKEND_API_URL=http://localhost:4000
BACKEND_PROJECT_ID=your-backend-project-id

# Excel Agent
OUTPUT_DIR=output

# Application under test
APP_BASE_URL=https://your-app-under-test.example.com
# Use a dedicated test account per person (and another for CI) rather than sharing one - the
# whole suite authenticates as this account, and tests run concurrently across team members/CI
# will collide (session interference, and eventually data collisions once a test mutates state)
# if everyone points at the same login. See README's Team Usage section.
APP_TEST_USERNAME=test-user@example.com
APP_TEST_PASSWORD=change-me

# Test Data via API - Restful-Booker-Platform (src/testData/booking.ts). Dedicated test
# credentials, never a real application session. RBP_API_BASE_URL defaults to the live public
# practice instance if omitted.
RBP_API_BASE_URL=https://automationintesting.online/api
RBP_AUTH_USERNAME=admin
RBP_AUTH_PASSWORD=password
